{
  "name": "mattiaciuni-website",
  "version": "1.0.0",
  "private": true,
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:pages": "node scripts/dev-pages.mjs",
    "preview": "npm run dev:pages",
    "predev": "node scripts/gen-cards.mjs && node scripts/gen-agent-files.mjs && node scripts/gen-rag.mjs",
    "build": "next build",
    "postbuild": "node scripts/fix-localized-html-lang.mjs && node scripts/gen-cards.mjs && node scripts/gen-agent-files.mjs && node scripts/gen-rag.mjs && node scripts/submit-google-sitemap.mjs && node scripts/ping-indexnow.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test:newsletter": "node scripts/test-newsletter.mjs",
    "test:admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-admin.mjs",
    "test:feedback": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-feedback.mjs",
    "test:security": "node scripts/security-audit.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "test:sitemap": "node scripts/check-sitemap-coverage.mjs",
    "email:preview": "tsx emails/render-preview.tsx",
    "email:template": "tsx emails/gen-template.tsx",
    "test:analytics": "node scripts/test-analytics.mjs",
    "test:collect": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-collect.mjs",
    "test:macbook-gate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-macbook-gate.mjs",
    "test:macbook-search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-macbook-search.mjs",
    "test:careers": "tsx scripts/test-careers.mjs",
    "test:job-feeds": "tsx scripts/test-job-feeds.mjs"
  },
  "dependencies": {
    "@animateicons/react": "^0.5.0",
    "@types/qrcode": "^1.5.6",
    "flag-icons": "^7.5.0",
    "lenis": "^1.3.26",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
